{
  "name": "winmate-v2-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node ../scripts/export_guide_context.mjs && node ../scripts/build_image_ranges.mjs && vite build && node scripts/build-exporter.mjs",
    "build:backgrounds": "node ../scripts/build_backgrounds.mjs",
    "build:guides": "node ../scripts/build_guide_gifs.mjs",
    "test:guides": "node ../tests/guide-gifs.mjs && node ../tests/guides.mjs",
    "build:spatial": "../.venv/bin/python -B ../scripts/build_spatial_products.py && node ../scripts/build_spatial_library.mjs",
    "build:spatial-previews": "node ../scripts/build_spatial_previews.mjs && node ../scripts/build_spatial_object_previews.mjs",
    "test:spatial": "node ../tests/spatial-scenes.mjs",
    "test:spatial:catalog": "node ../tests/spatial-template-catalog.mjs && node ../tests/spatial-template-catalog-ui.mjs",
    "test:spatial:form": "node ../tests/spatial-studio-form.mjs",
    "test:spatial:history-preview-ui": "node ../tests/spatial-history-preview-ui.mjs",
    "test:spatial:pagination-ui": "node ../tests/spatial-pagination-ui.mjs",
    "test:spatial:mentions": "node ../tests/spatial-product-mentions.mjs",
    "test:spatial:mentions-ui": "node ../tests/spatial-product-mentions-ui.mjs",
    "test:spatial:bubbles-ui": "node ../tests/spatial-mention-bubbles-ui.mjs",
    "test:feedback-ui": "node ../tests/feedback-popups-ui.mjs",
    "test:spatial:modules-ui": "node ../tests/spatial-module-loading-ui.mjs",
    "test:spatial:edit": "node ../tests/spatial-edit.mjs",
    "test:spatial:drawer": "node ../tests/spatial-selection.mjs && node ../tests/spatial-object-drawer-ui.mjs",
    "test:spatial:editor-ui": "node ../tests/spatial-editor-ui.mjs",
    "test:spatial:room-input-ui": "node ../tests/spatial-room-input-ui.mjs",
    "test:spatial:naturalness": "node ../tests/spatial-naturalness.mjs",
    "test:spatial:ui": "node ../tests/spatial-studio-flow-ui.mjs",
    "test:spatial:layout": "node ../tests/spatial-layout.mjs && node ../tests/spatial-my-layout.mjs && node ../tests/spatial-layout-ui.mjs",
    "test:spatial:layout-my": "node ../tests/spatial-my-layout.mjs && node ../tests/spatial-layout-my-ui.mjs",
    "test:spatial:saved-layouts": "node ../tests/spatial-saved-layouts-ui.mjs",
    "test:spatial:storyboard": "node ../tests/spatial-storyboard-layout.mjs && node ../tests/spatial-storyboard-ui.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:e2e": "node ../tests/real-functional-e2e.mjs",
    "test:contracts": "node ../tests/functional-contracts.mjs",
    "test:live": "node ../tests/live_frontend.mjs",
    "test:transport": "node ../tests/transport.mjs",
    "test:dev-proxy": "node --test ../tests/dev-proxy.mjs",
    "test:dev-proxy:live": "node ../tests/dev-proxy-live.mjs",
    "test:images": "node ../tests/image-states.mjs",
    "test:image-pagination": "node ../scripts/build_image_ranges.mjs && node --test ../tests/image-ranges.mjs && node ../tests/image-pagination.mjs",
    "test:layout-uniqueness": "node ../tests/layout-usage.mjs && node ../tests/layout-uniqueness-ui.mjs",
    "test:requirement-summary": "node ../tests/requirement-summary.mjs && node ../tests/requirement-summary-ui.mjs && node ../tests/requirement-summary-history.mjs",
    "test:my-page": "node ../tests/my-page.mjs",
    "test:new-proposal": "node ../tests/new-proposal.mjs",
    "test:layout-complete": "node ../tests/layout-complete.mjs",
    "test:sheet-sources": "node ../tests/sheet-sources.mjs",
    "test:layout-peek": "node --test ../tests/layout-peek-placement.mjs && node ../tests/layout-peek-ui.mjs",
    "test:catalog-search": "node ../tests/catalog-search.mjs && node ../tests/catalog-search-ui.mjs",
    "test:catalog-search:live": "node ../tests/catalog-search-live.mjs",
    "test:review": "node ../tests/review-report.mjs",
    "test:review-examples": "node ../tests/linked-review-examples.mjs",
    "test:criteria": "node ../tests/review-criteria.mjs",
    "test:simulation-skills": "node ../tests/simulation-skills.mjs && node ../tests/simulation-skills-ui.mjs",
    "test:simulation": "node ../tests/simulation-engine.mjs && node ../tests/persona-expressions.mjs && node ../tests/simulation-ui.mjs",
    "test:sharing": "node ../tests/storyboard-sharing.mjs",
    "test:backgrounds": "node ../tests/layout-backgrounds.mjs",
    "test:fidelity": "node ../tests/fidelity-runner.mjs",
    "test:layout-reflow:live": "node ../tests/layout-reflow.mjs",
    "test:layout-prompt:live": "node ../tests/layout-prompt.mjs",
    "test:layout-actions": "node --test ../tests/layout-actions.mjs",
    "test:layout-reflow:vision": "../.venv/bin/python -B ../tests/layout-reflow-vision.py",
    "test:layout-counts": "node ../tests/layout-repeat-counts.mjs --ui"
  },
  "dependencies": {
    "gifuct-js": "2.1.2",
    "jszip": "3.10.1",
    "pdfjs-dist": "3.11.174",
    "pptxgenjs": "3.12.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@babel/traverse": "7.28.5",
    "@vitejs/plugin-react": "4.7.0",
    "esbuild": "0.24.2",
    "playwright": "1.56.1",
    "postcss": "8.5.6",
    "postcss-value-parser": "4.2.0",
    "sharp": "0.35.5",
    "vite": "6.4.1"
  }
}
