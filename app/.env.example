# 서버 전용. 실제 .env는 git에 포함하지 않습니다.
WINMATE_MODE=dummy
# 개별 값이 전체 WINMATE_MODE보다 우선합니다.
# WINMATE_RFP_MODE=real
# WINMATE_LAYOUT_MODE=real
# WINMATE_STORYBOARD_MODE=real
# WINMATE_SEARCH_MODE=real
# WINMATE_REVIEW_MODE=real
# WINMATE_PART_MODE=real
# WINMATE_FILL_MODE=real
# WINMATE_SIMULATION_MODE=real
# WINMATE_LLM_MODE=real
# 키 미지정 시 기존 poc/.env를 서버에서만 읽습니다.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
WINMATE_LLM_CACHE=off
WINMATE_KB_CACHE=off
# 포트는 실행 환경에서 지정: WINMATE_API_PORT=8788 ./start.sh
