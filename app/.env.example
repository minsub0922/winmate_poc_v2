# 서버 전용 설정. 기본은 사내 LLM이며 Gemini는 명시적으로 선택합니다.
WINMATE_LLM_PROVIDER=internal

# 사내 LLM: BOOTSTRAP.md에 입력한 절대경로의 API 자료를 보고 설정합니다.
INTERNAL_LLM_API_KEY=
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=
# 생략하면 INTERNAL_LLM_MODEL을 사용합니다.
INTERNAL_LLM_QUICK_MODEL=
INTERNAL_LLM_VISION_MODEL=

# Gemini: WINMATE_LLM_PROVIDER=gemini일 때만 사용합니다.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_QUICK_MODEL=gemini-3.1-flash-lite
# GEMINI_BASE_URL=

# 공통 호출 정책. 모든 모델·기능·재시도를 합산합니다.
WINMATE_LLM_TIMEOUT=60
WINMATE_LLM_RPM=42
WINMATE_LLM_CONCURRENCY=4
WINMATE_LLM_QUEUE_BACKEND=sqlite
WINMATE_LLM_QUEUE_TIMEOUT=600
WINMATE_LLM_SCHEMA_MODE=json_object
WINMATE_LLM_CACHE=off
WINMATE_KB_CACHE=on
# 실행 포트는 셸에서 WINMATE_API_PORT=8788 ./start.sh 로 지정합니다.
