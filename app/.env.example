# 서버 전용. Gemini 키는 프런트나 Git에 포함하지 않습니다.
# 키 미지정 시 기존 poc/.env에서 읽습니다. 키가 없으면 서버 기동이 중단됩니다.
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_QUICK_MODEL=gemini-3.1-flash-lite
WINMATE_GEMINI_TIMEOUT=60
WINMATE_GEMINI_RPM=120
WINMATE_GEMINI_CONCURRENCY=4
WINMATE_LLM_CACHE=off
WINMATE_KB_CACHE=on
# 항상 실제 Gemini만 실행합니다. 모드 전환·offline·더미 대체는 없습니다.
# 포트: 실행 셸에서 WINMATE_API_PORT=8788 ./start.sh
