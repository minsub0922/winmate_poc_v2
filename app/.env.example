# 서버 전용 인증 키. 기존 GEMINI_* 설정은 그대로 지원합니다.
# 키 미지정 시 기존 poc/.env에서 읽습니다. 키가 없으면 서버 기동이 중단됩니다.
WINMATE_LLM_PROVIDER=gemini
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_VISION_MODEL=gemini-3.8-flash
# GEMINI_QUICK_MODEL=gemini-3.1-flash-lite
WINMATE_LLM_TIMEOUT=60
# 모든 모델·기능·재시도 합산, 임의의 연속 60초에 최대 42회. 0으로 해제할 수 없습니다.
WINMATE_LLM_RPM=42
WINMATE_LLM_CONCURRENCY=4
# SQLite: 같은 서버의 모든 프로세스가 아래 DB를 공유합니다(기본 경로 자동 사용).
WINMATE_LLM_QUEUE_BACKEND=sqlite
# WINMATE_LLM_QUEUE_DB=/absolute/path/to/app/data/runtime/llm-queue.sqlite
WINMATE_LLM_QUEUE_TIMEOUT=600
# 여러 서버는 하나의 Redis와 동일 namespace를 공유해야 합니다.
# WINMATE_LLM_QUEUE_BACKEND=redis
# WINMATE_LLM_REDIS_URL=redis://127.0.0.1:6379/0
# WINMATE_LLM_QUEUE_NAMESPACE=winmate-llm
# 사내 Chat Completions 호환 모델로 전환할 때 아래 4개를 설정합니다.
# WINMATE_LLM_PROVIDER=openai
# WINMATE_LLM_BASE_URL=https://internal.example/v1
# WINMATE_LLM_API_KEY=
# WINMATE_LLM_MODEL=internal-model
# WINMATE_LLM_QUICK_MODEL=internal-model
# WINMATE_LLM_VISION_MODEL=internal-vision-model
# JSON Schema를 네이티브 지원하는 게이트웨이는 json_schema로 설정합니다.
# WINMATE_LLM_SCHEMA_MODE=json_object
WINMATE_LLM_CACHE=off
WINMATE_KB_CACHE=on
# 항상 실제 모델만 실행합니다. 모델 실패 시 offline·더미 대체는 없습니다.
# 포트: 실행 셸에서 WINMATE_API_PORT=8788 ./start.sh
