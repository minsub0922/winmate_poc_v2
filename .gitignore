# 로컬 장표 작업물 (PPT 레이아웃 · as-is/to-be 등)
ppt_layouts/

# Admin source and startup marker are versioned; generated/private state stays local
/admin/runtime/
/admin/web/dist/

# Migration: credentials and local execution state
**/.env
**/.env.*
!**/.env.example
**/.secret
**/session.secret
**/credentials.json
**/*.pem
**/*.key
**/node_modules/
**/.venv/
**/__pycache__/
**/.pytest_cache/
.DS_Store
poc/test/testbench/auth.json

# Stage 0: raw export is retained locally; unpacked published files are versioned
reference/live/published.zip
reference/source-build/
reference/source-build-latest/
# Reproducible intermediate duplicates (keep final diffs, manifests and focused evidence)
docs/migration/evidence/*.pretty.js
docs/migration/evidence/source.names-normalized.js
docs/migration/evidence/live.js
docs/migration/evidence/source.js
docs/migration/evidence/dist.js
docs/migration/evidence/dist.css
docs/migration/evidence/source-vs-live-js.diff
docs/migration/evidence/source-vs-live-semantic.diff
docs/migration/evidence/bundle-change-hunks.json
docs/migration/evidence/bundle-changes-compact.json
docs/migration/evidence/live-page-assets.json

# 사내망 전용 모델 연결 코드(GaussLLM · ClefDecision — 계약 app/api/llm/inhouse_contract.py): 사내 API 규격이 든 코드는
# git 에 올리지 않는다. 이 폴더에서는 작성 안내(README.md)만 올라간다.
/app/api/llm/inhouse/*
!/app/api/llm/inhouse/README.md

# Local application generated state
app/data/runtime/
# Ops stack (ops/): generated secrets live in the single root .env (covered above); snapshots and logs stay local
/ops/data/
app/web/dist/
app/tests/output/
app/tests/legacy-work/

# Local build/transfer history; required source assets live in the versioned app/data, img and proddb inputs.
/output/
/.codex-build/
/.wm_tmp/
/_to_delete/
/.dev_md5.txt
/winmatev2*.zip
