# Winmate 단일 설정 파일 견본. 저장소 루트에서: cp -n .env.example .env
# 앱(app/) · 실험 도구(poc/test/) · 운영 스택(ops/)이 모두 루트 .env 하나만 읽는다. 실제 값은 Git에 올리지 않는다.
# 우선순위: 실행 환경(셸 변수) > .env

# 기본 관리자 계정: 로그인 계정이 하나도 없으면 서버 시작(또는 manage_auth.py --ensure) 때
# 아이디 admin · 아래 비밀번호로 만든다(8자 이상). 이미 계정이 있으면 바꾸지 않는다.
# 비워 두면 --ensure가 무작위 비밀번호를 만들어 터미널에 한 번 보여 준다.
WINMATE_ADMIN_PASSWORD=

# ================================================================ 포트 · 바인딩 (전 구성요소)
# 이 저장소가 호스트에 여는 포트와 바인딩 주소의 기본값은 모두 여기에만 있다 — 코드 · 스크립트에는 숫자를 두지 않는다.
# 바꿀 때는 루트 .env에 같은 줄을 넣거나(영구), 셸에서 WINMATE_API_PORT=8794 ./start.sh 처럼 지정한다(한 번).
# 읽는 순서: 셸 변수 > .env > .env.example  (app/scripts/ports.sh · app/web/ports.js · app/api/runtime_env.py port_value)
# 주석은 줄 앞에만 쓴다. 바인딩 127.0.0.1 = 이 컴퓨터에서만, 0.0.0.0 = 같은 네트워크의 다른 기기에서도 열림.

# Winmate 웹 · API · /admin (./start.sh · make restart · admin/start.sh · make tunnel · make smoke): http://127.0.0.1:8788
WINMATE_BIND_HOST=127.0.0.1
WINMATE_API_PORT=8788
# 개발용 Vite 서버 (npm --prefix app/web run dev). /api 등은 위 WINMATE_API_PORT로 프록시한다.
WINMATE_WEB_PORT=5173
# LLM 큐 Redis (make llm-redis → app/compose.llm.yml, 컨테이너 6379). 바꾸면 WINMATE_LLM_REDIS_URL의 포트도 같이 바꾼다.
LLM_REDIS_BIND=127.0.0.1
LLM_REDIS_PORT=6379
# 이미지 캐시 Redis (bash app/scripts/cache_redis.sh up): 포트는 아래 「이미지 캐시 Redis」 구역 WINMATE_CACHE_REDIS_URL의 포트(6380)가 정한다.
# PoC 테스트 벤치 (poc/test/testbench/start.sh)
TESTBENCH_HOST=127.0.0.1
TESTBENCH_PORT=8787
# 로컬 Clef 서버 (clef-flash/, 인증 없음 — 바인딩을 넓히지 말고 SSH 터널을 쓴다). 바꾼 뒤 bash clef-flash/install.sh --no-bench,
# 그리고 아래 TYPESAFE_BASE_URL(http://127.0.0.1:<CLEF_PORT>/v1)의 포트도 같이 바꾼다.
CLEF_HOST=127.0.0.1
CLEF_PORT=8790
# 운영 모니터링 (ops/) — 호스트에 여는 포트는 이 둘뿐. 바꾼 뒤 bash ops/start.sh
OPS_BIND=127.0.0.1
# Langfuse 웹 · API: http://localhost:8810 (컨테이너 3000)
LANGFUSE_PORT=8810
# Metabase: http://localhost:8820 (컨테이너 3000)
METABASE_PORT=8820
# 공간 조감도 미리보기 · 검토 스크립트가 잠깐 띄우는 Vite 서버 (app/scripts/build_spatial_*.mjs · review_spatial_*.mjs)
SPATIAL_EXAMPLE_PREVIEW_PORT=5194
SPATIAL_PREVIEW_PORT=5195
SPATIAL_PEOPLE_REVIEW_PORT=5225
SPATIAL_DENSITY_REVIEW_PORT=5226
SPATIAL_PURPOSE_REVIEW_PORT=5228
SPATIAL_ALL_ROOMS_REVIEW_PORT=5235
SPATIAL_CHARACTER_REVIEW_PORT=5240
# 호스트에 열지 않는 내부 포트(Docker 네트워크 winmate-ops_default, 고정): langfuse-worker 3030 · clickhouse 8123/9000 ·
#   langfuse-postgres 5432 · langfuse-redis 6379 · minio 9000 · analytics-db 5432(DB metabase · winmate)
# 자동 테스트(app/tests)는 실행 중인 서버와 겹치지 않도록 테스트마다 따로 정한 임시 포트를 쓴다(이 파일 대상 아님).

# ================================================================ LLM 제공자 (app · poc/test)
# 서버 전용 설정. LLM API 프로필 여러 개를 아래처럼 함께 적어 두고 WINMATE_LLM_PROVIDER로 앱이 쓸 것을 고른다.
# 프로필마다 키 · 모델 · 주소가 따로라서 바꿔도 다른 API의 키가 섞여 나가지 않는다. 기본은 OpenRouter(Qwen3.6-35B-A3B).
# 선택지: openrouter(기본) | gemini | internal | openai(WINMATE_LLM_* 공통 키) | 등록한 어댑터
WINMATE_LLM_PROVIDER=openrouter

# OpenRouter: 키 하나로 여러 회사 모델을 쓰는 게이트웨이(chat-completions). 키 발급 openrouter.ai/keys
OPENROUTER_API_KEY=
# 기본 qwen/qwen3.6-35b-a3b (262k 컨텍스트, 텍스트 · 이미지 입력, 입력 $0.10 · 출력 $0.90 / 1M 토큰)
OPENROUTER_MODEL=qwen/qwen3.6-35b-a3b
# 생략하면 OPENROUTER_MODEL을 사용합니다(이미지 입력도 같은 모델).
OPENROUTER_QUICK_MODEL=
OPENROUTER_VISION_MODEL=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# 모델의 생각(thinking) 단계: off(기본 — JSON 작업이 2~3배 빠르고 형식 성공률 같음) | on | low | medium | high
OPENROUTER_REASONING=off

# 사내 LLM(Gauss 등, WINMATE_LLM_PROVIDER=internal): 사내 API 규격에 맞춘 연결 코드는 git에 올리지 않고
#   app/api/llm/inhouse/gauss.py 의 class GaussLLM 으로 둔다(.gitignore 제외 · 계약 app/api/llm/inhouse_contract.py ·
#   작성 안내 app/api/llm/inhouse/README.md · 확인 app/.venv/bin/python -m app.api.llm.inhouse_bridge check --live).
#   그 파일 · 클래스와 클래스의 필수 키(REQUIRED_ENV, 기본은 아래 API_KEY · BASE_URL · MODEL)가 모두 있으면 그 클래스로,
#   파일이 없으면 chat-completions 호환 전송으로 연결한다. INTERNAL_ · GAUSS_ · CLEF_ · INHOUSE_ 로 시작하는 키는 모두 클래스에 전달된다.
INTERNAL_LLM_API_KEY=
# 사내 API 의 클라이언트 키 · 사용자 이메일(요청 헤더 · 본문에 넣는 값 — GaussLLM 이 읽는다)
INTERNAL_LLM_CLIENT_KEY=
INTERNAL_LLM_USER_EMAIL=
INTERNAL_LLM_BASE_URL=
INTERNAL_LLM_MODEL=
# 생략하면 INTERNAL_LLM_MODEL을 사용합니다.
INTERNAL_LLM_QUICK_MODEL=
INTERNAL_LLM_VISION_MODEL=
# 사내 검색 — GaussLLM 이 CAPABILITIES 에 'search' 를 두면 시장조사 · 시뮬레이션의 「모델 검색」 수단이 이 검색을 쓴다.
INTERNAL_SEARCH_API_KEY=
INTERNAL_SEARCH_CLIENT_KEY=
# INTERNAL_SEARCH_BASE_URL=
# https 가 아닌데도 보내도 되는 사내 도메인(쉼표). 사설 IP · 점 없는 호스트 · .internal 같은 이름은 적지 않아도 된다.
# INHOUSE_HTTP_HOSTS=
# 사내 연결 클래스 폴더(기본 app/api/llm/inhouse — 저장소 루트 기준 또는 절대 경로)
# WINMATE_INHOUSE_DIR=app/api/llm/inhouse
# 대표 LLM이 응답하지 못하면(연결 · 시간 초과 · 인증 · 5xx/429 · 지원하지 않는 입력) 이 순서로 대신 답한다(쉼표, 비우면 없음).
# 관리자 Provider 탭에서 켜기/끄기 · 대표를 바꾸면 그 값이 이 줄보다 먼저 적용된다.
# WINMATE_LLM_FALLBACK=

# Gemini: 앱은 WINMATE_LLM_PROVIDER=gemini일 때만 사용합니다. poc/test 실험 도구는 항상 Gemini를 씁니다.
GEMINI_API_KEY=
GEMINI_MODEL=gemma-4-31b-it
GEMINI_QUICK_MODEL=gemma-4-31b-it
GEMINI_VISION_MODEL=gemma-4-31b-it
# GEMINI_BASE_URL=

# 공통 호출 정책. 모든 모델·기능·재시도를 합산합니다.
WINMATE_LLM_TIMEOUT=60
WINMATE_LLM_RPM=42
WINMATE_LLM_CONCURRENCY=4
WINMATE_LLM_QUEUE_BACKEND=sqlite
WINMATE_LLM_QUEUE_TIMEOUT=600
WINMATE_LLM_SCHEMA_MODE=json_object
WINMATE_LLM_CACHE=off
WINMATE_KB_CACHE=on

# ================================================================ 이미지 캐시 Redis (app — 3D 조감도 미리보기 등 무거운 이미지)
# 서버가 렌더링한 이미지를 L1 Redis(메모리) → L2 파일(app/data/runtime) 순으로 캐시한다. 이 Redis는 캐시 전용이며
# LLM 큐 Redis(compose.llm.yml, noeviction · 영속)와 같은 인스턴스를 쓰면 서버가 거부한다.
# 띄우기: bash app/scripts/cache_redis.sh up  (Docker → app/compose.cache.yml, 없으면 redis-server를 같은 옵션으로 실행 —
#   redis-server도 없으면 npm redis-memory-server로 아래 버전을 app/data/runtime/redis-bin에 한 번 빌드. 빌드만: … install)
# redis | memory | off. 비우면 URL이 있을 때 redis, 없으면 프로세스 내 메모리 캐시
WINMATE_CACHE_BACKEND=redis
WINMATE_CACHE_REDIS_URL=redis://127.0.0.1:6380/0
# 최대 메모리(상한 3gb, 넘기면 3gb로 제한) · 가득 차면 오래 안 쓴 이미지부터 버리는 정책
WINMATE_CACHE_REDIS_MAXMEMORY=3gb
WINMATE_CACHE_REDIS_POLICY=allkeys-lru
# 서버 시작 때 위 두 값을 CONFIG SET으로 적용(관리형 Redis처럼 막혀 있으면 확인만 하고, 상한 · 정책이 안 맞으면 쓰지 않음)
WINMATE_CACHE_REDIS_MANAGE=on
WINMATE_CACHE_NAMESPACE=winmate-cache
# 항목 만료(초, 7일) · 한 항목 최대 크기 · Redis를 못 쓸 때 프로세스 내 캐시 상한
WINMATE_CACHE_TTL=604800
WINMATE_CACHE_MAX_ITEM_BYTES=8mb
WINMATE_CACHE_MEMORY_MAX_BYTES=256mb
# Redis 버전(재현용 고정) — Docker는 redis:<버전>-alpine, Docker가 없으면 cache_redis.sh install이 npm(redis-memory-server)으로 같은 버전을 빌드
WINMATE_CACHE_REDIS_VERSION=7.4.2

# ================================================================ 3D 조감도 서버 렌더러 (app)
# 카드 미리보기를 브라우저 WebGL 대신 서버(headless Chromium, app/scripts/spatial_render_worker.mjs)가 그린다.
# 꺼지거나 실패하면 브라우저가 예전처럼 직접 그린다. Chromium: Playwright 고정판 → 설치된 Chrome 순(경로 지정은 아래)
WINMATE_SPATIAL_RENDERER=on
WINMATE_SPATIAL_RENDER_CONCURRENCY=2
WINMATE_SPATIAL_RENDER_TIMEOUT=60
# 시작 후 현재 라이브러리의 템플릿 미리보기를 백그라운드로 미리 렌더(사용자 요청이 항상 먼저)
WINMATE_SPATIAL_PREWARM=on
# WINMATE_SPATIAL_RENDER_CHROME=/usr/bin/google-chrome
# WINMATE_SPATIAL_PREVIEW_DIR=app/data/runtime/spatial-previews

# ================================================================ 계정 데이터 (app)
# 제안서 · 검토 · 시뮬레이션 · 찜 · 고객 프로필 · 업로드 이미지 · 첨부 원문 · 건물 조감도의 서버 저장소(SQLite).
# 브라우저 저장소는 화면을 바로 그리기 위한 캐시로만 쓴다.
# WINMATE_ACCOUNT_DATA_DB=app/data/runtime/account_data.sqlite

# ================================================================ Decision 모델 (app — TypeSafe Jev, System One API)
# 키가 있으면 판단형 작업(후보 고르기 · 순위 · 관련도 · 우선순위)을 LLM 대신 Decision 모델로 처리하고,
# 키가 없거나 WINMATE_DECISION=off면 같은 작업을 LLM으로 처리한다. 작업의 입력 · 출력 형식은 두 경로가 같다.
# 대상 작업: search.rerank · catalog.rank · review.route · layout.pick · layout.best_pick (docs/decision-model/REPORT.md)
#          spatial.command — 조감도 스튜디오 명령 중 '요청 하나 + 대상이 모두 @로 태그된 것'만 (app/api/spatial_command.py), 나머지는 LLM
# 키 발급: console.typesafe.ai (서버 전용, 프런트 · Git에 넣지 않음)
TYPESAFE_API_KEY=
# 공식 엔드포인트(뒤에 /systemone이 붙음). 키는 이 엔드포인트에서 발급한 것이어야 한다.
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
# 모델 ID. 임계값을 이 버전 기준으로 맞췄으므로 버전을 고정한다(jev-latest는 새 버전이 나오면 바뀜).
# Jev 1.14: 입력 토큰당 과금($0.042/1M, 출력 무료) · 요청당 64k · 질문당 32k 토큰 · choice/score/noul/box
TYPESAFE_MODEL=jev-1.14.0
# 대안: 같은 Mac에서 띄운 로컬 Clef 서버(clef-flash/, 같은 System One API, 인증 없음 · 요청당 16k 토큰 · 한 번에 1요청).
# 포트는 위 「포트 · 바인딩」의 CLEF_PORT와 같아야 한다. 이 서버 주소(127.0.0.1)만 http를 허용한다. 로컬 서버는 키를 확인하지 않으니 TypeSafe 키 대신 local 같은 아무 값을 넣는다.
# 비교 결과: docs/decision-model/FINAL-REPORT.md
# TYPESAFE_API_KEY=local
# TYPESAFE_BASE_URL=http://127.0.0.1:8790/v1
# TYPESAFE_MODEL=clef-flash
# WINMATE_DECISION_TIMEOUT=120
# 사내 Decision(CLEF): app/api/llm/inhouse/clef.py 의 class ClefDecision(git 제외)이 있고 그 필수 키가 있으면 순서 칸 「inhouse」로 쓴다.
#   서버 주소 · 모델 · SSH 터널 같은 연결 정보는 클래스가 읽는 사내 설정(예: admin/runtime/clef_remote.json — git 제외)에 둔다.
#   질문 · 답 형식은 위 System One 그대로(choice · score · noul), 요청 하나의 제한 시간은 클래스의 TIMEOUT(기본 120초)과 아래 값 중 큰 것.
# Decision 칸 순서(쉼표): main(위 TYPESAFE_*) · clef(이 컴퓨터의 Clef 서버) · inhouse(사내 ClefDecision). 앞의 것이 답하고,
# 답하지 못하면 다음 것이 같은 질문에 답한다. 관리자 Provider 탭에서 바꾸면 그 값이 먼저 적용된다. 사내망 예: inhouse
# WINMATE_DECISION_ORDER=main
# auto: 키가 있으면 Decision 모델 사용 | off: 항상 LLM
WINMATE_DECISION=auto
# 선택: 일부 작업만 Decision 모델로(쉼표 구분, 비우면 대상 작업 전부). 예: search.rerank,layout.pick
WINMATE_DECISION_TASKS=
# 요청당 제한 시간(초, 재시도 포함)
WINMATE_DECISION_TIMEOUT=30

# ================================================================ Provider 상태 점검 (admin — /admin/providers)
# 활성 Provider 중 사내 · 자체 서빙(internal 프로필, 또는 주소가 이 서버 · 사내망)만 이 주기(초)로 점검한다. 60 이상, off = 끄기.
# 외부 API(OpenRouter · Gemini · TypeSafe)는 점검하지 않고 실제 호출 기록만 보여 준다. 점검은 토큰을 쓰지 않는 호출(/models · /health).
# 사내 서빙 주소 · 모델 ID를 관리자 화면에서 바꾸면 admin/runtime에 저장되어 이 파일의 값보다 먼저 적용된다(화면에서 되돌릴 수 있음).
WINMATE_PROVIDER_CHECK_INTERVAL=600

# ================================================================ 시장조사 (app · 업종 트렌드 장의 웹 검색 근거)
# 레이아웃 자동 구성 · 장 채우기가 업종 트렌드 장(연도별 추이 · 구성비 · 핵심 지표 · 키워드)과 시장 장의 값을 실제 웹 문서에서 찾아
# 원문과 대조한 근거로만 채운다(app/api/poc/market_research.py). 고객사는 예측할 수 없으므로 조사는 언제나 그 고객의 요구사항에서 뽑은
# 검색어로 새로 하고(동적 검색), 얻은 것을 근거 DB에 쌓아 다음 조사에서 다시 쓴다. 별도 검색 API 키는 쓰지 않는다.
# 바깥으로 나가는 것은 공개 검색어와 출처 페이지 요청뿐이다 — 고객사 이름 · 연락처 · 금액은 검색어에서 지운다.
# on(기본) | off — off면 웹 검색을 하지 않는다
WINMATE_RESEARCH=on
# 같은 요청(업종 · 요구사항 · 품목이 같을 때)의 조사 결과를 다시 쓰는 시간(시간, 기본 24 · 0이면 매번 새로 조사) — 저장 위치 app/data/runtime/research
WINMATE_RESEARCH_TTL=24
# 한 번 조사에 쓰는 검색 문장 수 상한(기본 11)
WINMATE_RESEARCH_QUERIES=11
# 검색 수단(쉼표로, 기본은 아래 전부). 운영망에서 바깥 사이트에 접속할 수 없으면 db 만 두면 쌓인 근거 DB로만 조사한다.
#   llm     모델 연결의 웹 검색(사내 LLM 어댑터의 검색 · Gemini의 Google 검색) — 연결이 지원할 때만 쓰인다(OpenRouter · OpenAI 호환은 미지원)
#   db      근거 DB에 쌓인 문서에서 다시 찾기
#   korea   정책브리핑(전 부처 보도자료) · mk 매일경제 · edaily 이데일리 · herald 헤럴드경제 · hani 한겨레 · zdnet 지디넷코리아 · kdi KDI 경제정책정보(느려서 기본에서 뺌)
#           — 각 사이트의 자체 검색을 서버가 직접 부른다. robots.txt 가 허용한 주소만, 사이트마다 간격을 두고 받는다(app/api/poc/market_sources.py).
# WINMATE_RESEARCH_ENGINES=llm,db,korea,mk,edaily,herald,hani,zdnet
# 근거 DB(SQLite) — 검색 결과 · 정제한 본문 · 검증을 통과한 근거를 쌓는다. 고객사 이름 · 요구사항은 저장하지 않는다. off면 쌓지도 다시 쓰지도 않는다
WINMATE_RESEARCH_STORE=on
# 근거 DB 파일(기본 app/data/runtime/research/evidence.db) — 개발망에서 쌓은 파일을 운영으로 옮겨 쓸 수 있다
# WINMATE_RESEARCH_DB=
# 저장 근거를 새 검색 없이 쓰는 기간(일, 기본 30) — 이 기간 안에 확인한 근거가 충분한 주제는 검색을 건너뛴다. 지나면 다시 검색하고 저장 근거는 보조로 쓴다
WINMATE_RESEARCH_REUSE_DAYS=30
# 저장 근거를 보조로 쓰는 기간(일, 기본 365) · 같은 검색어의 결과 목록을 다시 쓰는 시간(시간, 기본 168)
WINMATE_RESEARCH_KEEP_DAYS=365
WINMATE_RESEARCH_SEARCH_TTL=168

# ================================================================ 실험 도구 (poc/test)
# poc/test/sim_eval 영업 담당자 · 독립 심사 모델(고객 역할 SIM_CUSTOMER_MODEL은 생략하면 GEMINI_MODEL)
SIM_SELLER_MODEL=gemma-4-31b-it
SIM_JUDGE_MODEL=gemma-4-31b-it

# ================================================================ 운영 모니터링 (ops/ — Langfuse · Metabase)
# bash ops/start.sh가 이 구역(과 맨 위 「포트 · 바인딩」의 OPS_BIND · LANGFUSE_PORT · METABASE_PORT)을 기준으로 루트 .env를 채운다 — .env에 없거나 값이 빈 항목만:
#   값이 있는 항목 → 그대로, 값이 빈 항목(비밀값) → 무작위 생성. 이미 값이 있으면 덮어쓰지 않는다.
# 버전 · 연결 설정은 .env에서 바꾼 뒤 bash ops/start.sh(연결 설정은 make restart까지). 포트 · 바인딩은 맨 위 「포트 · 바인딩」 구역.
# 비밀값은 처음 만든 데이터 볼륨과 짝이라 만든 뒤에는 바꾸지 않는다. 주석은 줄 앞에만 쓴다.

# 관리자 계정 (Langfuse · Metabase 공통 이메일)
OPS_ADMIN_EMAIL=admin@winmate.local
LANGFUSE_ADMIN_PASSWORD=
METABASE_ADMIN_PASSWORD=

# Langfuse 프로젝트와 Winmate → Langfuse 연결 (호스트 · 키가 모두 있어야 전송이 켜진다)
LANGFUSE_PROJECT_ID=winmate
# 비워 두면 start.sh가 http://127.0.0.1:<LANGFUSE_PORT>로 채우고, 포트를 바꾸면 따라 바꾼다
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Winmate → Langfuse 전송 on/off, 프롬프트 · 응답 본문 포함 on/off(off면 모델 · 토큰 · 지연 · 오류만), environment 이름
WINMATE_LANGFUSE=on
WINMATE_LANGFUSE_CONTENT=on
WINMATE_LANGFUSE_ENVIRONMENT=winmate
# Metabase용 운영 DB 스냅샷: 위치(저장소 기준, 바꾸지 않음) · 주기(초) · 스팬 보관 일수
WINMATE_ANALYTICS_DIR=ops/data/snapshots
WINMATE_ANALYTICS_INTERVAL=300
WINMATE_ANALYTICS_DAYS=90
# 스냅샷 → 분석 DB(Postgres) 적재 확인 주기(초)
SYNC_INTERVAL=60

# 이미지 버전 (재현용 고정, 2026-11-13 검증)
LANGFUSE_IMAGE_TAG=4.79.0
METABASE_IMAGE_TAG=v0.65.4.3
CLICKHOUSE_IMAGE_TAG=26.3.62.3
POSTGRES_IMAGE_TAG=17.12
REDIS_IMAGE_TAG=7.4.12
# Chainguard MinIO는 latest 태그만 공개라 digest로 고정 (받을 수 없게 되면 cgr.dev/chainguard/minio:latest)
MINIO_IMAGE=cgr.dev/chainguard/minio@sha256:96b6cf3e14084d3427ec46de10c2873af61b945ad9272eec266cfc8df551cba5
# winmate-sync(적재기) · metabase-init 이미지 베이스
PYTHON_IMAGE=python:3.12.16-slim

# 내부 비밀값 (비워 두면 처음 실행 때 생성)
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_POSTGRES_PASSWORD=
LANGFUSE_REDIS_PASSWORD=
CLICKHOUSE_PASSWORD=
CLICKHOUSE_METABASE_PASSWORD=
MINIO_ROOT_PASSWORD=
ANALYTICS_POSTGRES_PASSWORD=
METABASE_DB_PASSWORD=
ANALYTICS_LOADER_PASSWORD=
ANALYTICS_READER_PASSWORD=
METABASE_SESSION_SECRET=
METABASE_ENCRYPTION_SECRET=
